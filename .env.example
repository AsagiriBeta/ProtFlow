# ProtFlow Environment Configuration
# Copy this file to .env and fill in your values

# HuggingFace Token (required for ESM3)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Prokka Configuration (for Prokka → ESM3 → DALI workflow)
PROKKA_ENV_NAME=prokka
PROKKA_BIN=
PROTFLOW_AUTO_CREATE_PROKKA=1

# Workflow Directories
PROTFLOW_ROOT=
PROTFLOW_WORKDIR=
PROTFLOW_INPUT_FNA=

# Python Dependencies
PROTFLOW_AUTO_INSTALL_PY=0

# JupyterHub Detection
JUPYTERHUB_SERVICE_PREFIX=

