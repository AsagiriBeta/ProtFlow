# ProtFlow Output Directories
# Ignore all files in outputs, but keep .gitkeep
outputs/*
!outputs/.gitkeep
outputs/**/*
!outputs/**/.gitkeep

# Data Directories (keep structure, ignore content)
# Ignore all files in data subdirectories, but keep .gitkeep files
data/inputs/*
!data/inputs/.gitkeep
data/inputs/**/*
!data/inputs/**/.gitkeep
data/pdbs/*
!data/pdbs/.gitkeep
data/pdbs/**/*
!data/pdbs/**/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/outputs/**/*
!data/outputs/**/.gitkeep
data/antismash_out/*
!data/antismash_out/.gitkeep
data/antismash_out/**/*
!data/antismash_out/**/.gitkeep

# Notebooks data directories
notebooks/**/data/*
!notebooks/**/data/.gitkeep
notebooks/**/data/**/*
!notebooks/**/data/**/.gitkeep
notebooks/**/outputs/*
!notebooks/**/outputs/.gitkeep
notebooks/**/outputs/**/*
!notebooks/**/outputs/**/.gitkeep

