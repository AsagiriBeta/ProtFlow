    "        df = pd.DataFrame(results['cluster_details'])\n",
    "        df['size'] = df['end'] - df['start']\n",
    "        \n",
    "        fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "        \n",
    "        # 1. 基因簇类型分布\n",
    "        type_counts = df['type'].value_counts()\n",
    "        axes[0, 0].pie(type_counts.values, labels=type_counts.index, autopct='%1.1f%%', startangle=90)\n",
    "        axes[0, 0].set_title('基因簇类型分布')\n",
    "        \n",
    "        # 2. 基因簇大小分布\n",
    "        axes[0, 1].hist(df['size'], bins=20, alpha=0.7, color='skyblue', edgecolor='black')\n",
    "        axes[0, 1].set_xlabel('基因簇大小 (bp)')\n",
    "        axes[0, 1].set_ylabel('数量')\n",
    "        axes[0, 1].set_title('基因簇大小分布')\n",
    "        axes[0, 1].axvline(df['size'].mean(), color='red', linestyle='--', label=f'平均值: {df[\"size\"].mean():.0f}')\n",
    "        axes[0, 1].legend()\n",
    "        \n",
    "        # 3. 按类型的基因簇大小\n",
    "        if len(df) > 1:\n",
    "            df.boxplot(column='size', by='type', ax=axes[1, 0])\n",
    "            axes[1, 0].set_xlabel('基因簇类型')\n",
    "            axes[1, 0].set_ylabel('大小 (bp)')\n",
    "            axes[1, 0].set_title('按类型的基因簇大小分布')\n",
",
    "            axes[1, 0].tick_params(axis='x', rotation=45)\n",
    "        \n",
    "        # 4. 基因簇在基因组上的位置\n",
",
    "        if 'contig' in df.columns:\n",
    "            for contig in df['contig'].unique()[:5]:  # 显示前5个contig\n",
",
    "                contig_data = df[df['contig'] == contig]\n",
",
    "                y_pos = list(contig_data['contig'].unique()).index(contig)\n",
",
    "                for _, row in contig_data.iterrows():\n",
",
    "                    axes[1, 1].barh(y_pos, row['end'] - row['start'], \n",
    "                                   left=row['start'], alpha=0.7, \n",
    "                                   label=row['type'] if y_pos == 0 else \"\")\n",
    "            \n",
    "            axes[1, 1].set_xlabel('基因组位置 (bp)')\n",
    "            axes[1, 1].set_ylabel('Contig')\n",
    "            axes[1, 1].set_title('基因簇在基因组上的分布')\n",
