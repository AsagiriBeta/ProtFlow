    "## 4. antiSMASH分析配置"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_antismash_config():\n",
    "    \"\"\"获取antiSMASH分析配置\"\"\"\n",
    "    \n",
    "    # 基本配置\n",
    "    config = {\n",
    "        'taxon': 'bacteria',           # 生物类型: bacteria, fungi\n",
    "        'analysis_depth': 2,           # 分析深度: 1=快速, 2=标准, 3=完整\n",
    "        'enable_cds': True,            # 启用CDS预测\n",
    "        'enable_pfs': True,            # 启用启动子预测\n",
    "        'enable_knownclusterblast': True,  # 已知簇比对\n",
    "        'enable_subclusterblast': True,    # 子簇比对\n",
    "        'enable_clusterblast': True,       # 簇比对\n",
    "        'enable_smcoogs': True,            # SMCOGs分析\n",
    "        'enable_tigrfam': True,            # TIGRFAM分析\n",
    "        'enable_pfam': True,               # Pfam分析\n",
    "        'output_dir': str(WORK_DIR / 'antismash_output')\n",
    "    }\n",
    "    \n",
    "    # 根据分析深度调整参数\n",
    "    if config['analysis_depth'] == 1:\n",
    "        config.update({\n",
    "            'enable_knownclusterblast': False,\n",
    "            'enable_subclusterblast': False,\n",
    "            'enable_clusterblast': False,\n",
    "            'enable_smcoogs': False,\n",
    "            'enable_tigrfam': False,\n",
    "            'enable_pfam': False\n",
    "        })\n",
    "    \n",
    "    elif config['analysis_depth'] == 3:\n",
    "        config.update({\n",
    "            'enable_knownclusterblast': True,\n",
    "            'enable_subclusterblast': True,\n",
    "            'enable_clusterblast': True,\n",
    "            'enable_smcoogs': True,\n",
    "            'enable_tigrfam': True,\n",
    "            'enable_pfam': True\n",
    "        })\n",
    "    \n",
    "    return config\n",
    "\n",
    "# 获取配置\n",
    "config = get_antismash_config()\n",
    "\n",
    "print(\"=== antiSMASH分析配置 ===\")\n",
    "print(f\"生物类型: {config['taxon']}\")\n",
    "print(f\"分析深度: {config['analysis_depth']}\")\n",
    "print(f\"输出目录: {config['output_dir']}\")\n",
    "print(f\"启用功能: {sum([v for k, v in config.items() if k.startswith('enable_') and v])} 项\")\n",
    "\n",
    "# 显示详细配置\n",
    "print(\"\\n详细配置:\")\n",
    "for key, value in config.items():\n",
    "    if key.startswith('enable_'):\n",
    "        status = \"✓\" if value else \"✗\"\n",
    "        print(f\"  {key.replace('enable_', '')}: {status}\")"
   ]
  },
