   "source": [
    "def parse_antismash_results(output_dir):\n",
    "    \"\"\"解析antiSMASH输出结果\"\"\"\n",
    "    \n",
    "    if not output_dir:\n",
    "        return None\n",
    "    \n",
    "    output_path = Path(output_dir)\n",
    "    \n",
    "    if not output_path.exists():\n",
    "        print(f\"❌ 输出目录不存在: {output_path}\")\n",
    "        return None\n",
    "    \n",
    "    results = {\n",
    "        'output_dir': str(output_path),\n",
    "        'html_report': None,\n",
",
    "        'gbk_files': [],\n",
    "        'cluster_types': {},\n",
    "        'num_clusters': 0,\n",
    "        'cluster_details': []\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        # 查找HTML报告\n",
    "        html_files = list(output_path.glob('*.html'))\n",
    "        if html_files:\n",
    "            results['html_report'] = str(html_files[0])\n",
    "            print(f\"✓ 找到HTML报告: {html_files[0].name}\")\n",
    "        \n",
    "        # 查找GenBank文件\n",
    "        gbk_files = list(output_path.glob('*.gbk')) + list(output_path.glob('*.gb'))\n",
    "        results['gbk_files'] = [str(f) for f in gbk_files]\n",
    "        print(f\"✓ 找到 {len(gbk_files)} 个GenBank文件\")\n",
    "        \n",
    "        # 解析cluster信息\n",
    "        cluster_file = output_path / 'cluster.txt'\n",
    "        if cluster_file.exists():\n",
    "            with open(cluster_file, 'r') as f:\n",
    "                cluster_content = f.read()\n",
    "            \n",
    "            # 简单的cluster类型统计\n",
    "            cluster_types = {}\n",
    "            for line in cluster_content.split('\\n'):\n",
    "                if 'Type:' in line:\n",
    "                    cluster_type = line.split('Type:')[1].strip().split()[0]\n",
    "                    cluster_types[cluster_type] = cluster_types.get(cluster_type, 0) + 1\n",
    "            \n",
    "            results['cluster_types'] = cluster_types\n",
    "            results['num_clusters'] = sum(cluster_types.values())\n",
    "        \n",
    "        # 解析详细cluster信息\n",
    "        for gbk_file in gbk_files:\n",
    "            try:\n",
    "                from Bio import SeqIO\n",
    "                for record in SeqIO.parse(gbk_file, 'genbank'):\n",
",
    "                    for feature in record.features:\n",
",
    "                        if feature.type == 'cluster':\n",
",
    "                            cluster_info = {\n",
",
