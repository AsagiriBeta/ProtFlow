   "source": [
    "## 5. 运行antiSMASH分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "from tqdm import tqdm\n",
    "import time\n",
    "\n",
    "def run_antismash_analysis(input_file, config):\n",
    "    \"\"\"运行antiSMASH分析\"\"\"\n",
    "    \n",
    "    if not antismash_ok:\n",
    "        print(\"❌ antiSMASH未正确安装\")\n",
    "        return None\n",
    "    \n",
    "    # 创建输出目录\n",
    "    output_dir = Path(config['output_dir'])\n",
    "    output_dir.mkdir(exist_ok=True, parents=True)\n",
    "    \n",
    "    # 构建命令\n",
    "    cmd = ['antismash', str(input_file)]\n",
    "    \n",
    "    # 添加参数\n",
    "    cmd.extend(['--taxon', config['taxon']])\n",
    "    cmd.extend(['--output-dir', str(output_dir)])\n",
    "    cmd.extend(['--cpus', str(min(8, os.cpu_count()))])  # 使用最多8个CPU\n",
    "    \n",
    "    # 添加功能开关\n",
    "    if config['enable_cds']:\n",
    "        cmd.append('--genefinding-tool')\n",
    "        cmd.append('prodigal')\n",
    "    \n",
    "    if config['enable_knownclusterblast']:\n",
    "        cmd.append('--knownclusterblast')\n",
    "    \n",
    "    if config['enable_subclusterblast']:\n",
    "        cmd.append('--subclusterblast')\n",
",
    "    if config['enable_clusterblast']:\n",
    "        cmd.append('--clusterblast')\n",
    "    \n",
    "    if config['enable_smcoogs']:\n",
    "        cmd.append('--smcogs')\n",
    "    \n",
    "    if config['enable_tigrfam']:\n",
    "        cmd.append('--tigrfam')\n",
    "    \n",
    "    if config['enable_pfam']:\n",
    "        cmd.append('--pfam')\n",
    "    \n",
    "    print(\"=== 运行antiSMASH分析 ===\")\n",
    "    print(f\"输入文件: {input_file}\")\n",
    "    print(f\"输出目录: {output_dir}\")\n",
    "    print(f\"命令: {' '.join(cmd)}\")\n",
    "    \n",
    "    # 记录开始时间\n",
    "    start_time = time.time()\n",
    "    \n",
    "    try:\n",
    "        # 运行antiSMASH\n",
    "        print(f\"\\n分析开始时间: {time.strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "        print(\"这可能需要几小时，请耐心等待...\")\n",
    "        \n",
    "        result = subprocess.run(\n",
    "            cmd,\n",
    "            capture_output=True,\n",
    "            text=True,\n",
    "            timeout=7200,  # 2小时超时\n",
    "            cwd=str(output_dir.parent)\n",
    "        )\n",
    "        \n",
    "        end_time = time.time()\n",
    "        duration = end_time - start_time\n",
    "        \n",
    "        print(f\"\\n分析完成时间: {time.strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "        print(f\"总耗时: {duration/60:.1f} 分钟\")\n",
    "        \n",
    "        if result.returncode == 0:\n",
    "            print(\"✓ antiSMASH分析成功完成\")\n",
    "            return str(output_dir)\n",
    "        else:\n",
    "            print(f\"❌ antiSMASH分析失败\")\n",
    "            print(f\"错误信息: {result.stderr[:500]}...\")\n",
    "            return None\n",
    "    \n",
    "    except subprocess.TimeoutExpired:\n",
    "        print(f\"⏰ 分析超时 (2小时)\")\n",
    "        return None\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"❌ 分析错误: {e}\")\n",
    "        return None\n",
    "\n",
    "# 运行分析\n",
    "if prepared_file and antismash_ok:\n",
    "    output_dir = run_antismash_analysis(prepared_file, config)\n",
    "else:\n",
    "    output_dir = None\n",
    "    print(\"⚠️ 无法运行分析: 缺少输入文件或antiSMASH未安装\")"
   ]
