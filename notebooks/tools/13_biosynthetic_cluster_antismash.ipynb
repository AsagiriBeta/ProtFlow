   "source": [
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from Bio import SeqIO\n",
    "\n",
    "def prepare_input_files(input_path):\n",
    "    \"\"\"准备输入文件\"\"\"\n",
    "    input_path = Path(input_path)\n",
    "    \n",
    "    if not input_path.exists():\n",
    "        print(f\"❌ 输入文件不存在: {input_path}\")\n",
    "        return None\n",
    "    \n",
    "    # 支持的文件格式\n",
    "    supported_formats = ['.gbk', '.gbff', '.fna', '.fa', '.fasta', '.gb']\n",
    "    \n",
    "    if input_path.is_file():\n",
    "        # 单个文件\n",
    "        if input_path.suffix in supported_formats:\n",
    "            print(f\"✓ 输入文件: {input_path.name}\")\n",
    "            \n",
    "            # 验证文件格式\n",
    "            try:\n",
    "                if input_path.suffix in ['.gbk', '.gbff', '.gb']:\n",
    "                    # GenBank格式\n",
    "                    records = list(SeqIO.parse(input_path, 'genbank'))\n",
    "                    print(f\"  包含 {len(records)} 条序列\")\n",
    "                    \n",
    "                    # 显示序列信息\n",
    "                    for i, record in enumerate(records[:3]):  # 显示前3个\n",
    "                        print(f\"    {i+1}. {record.id} (长度: {len(record.seq)} bp)\")\n",
    "                    \n",
    "                    if len(records) > 3:\n",
    "                        print(f\"    ... 还有 {len(records) - 3} 个序列\")\n",
    "                \n",
    "                else:\n",
    "                    # FASTA格式\n",
    "                    records = list(SeqIO.parse(input_path, 'fasta'))\n",
    "                    print(f\"  包含 {len(records)} 条序列\")\n",
    "                    \n",
    "                    for i, record in enumerate(records[:3]):\n",
    "                        print(f\"    {i+1}. {record.id} (长度: {len(record.seq)} bp)\")\n",
    "                    \n",
    "                    if len(records) > 3:\n",
    "                        print(f\"    ... 还有 {len(records) - 3} 个序列\")\n",
    "                \n",
    "                return str(input_path)\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"❌ 文件格式错误: {e}\")\n",
    "                return None\n",
    "        \n",
    "        else:\n",
    "            print(f\"❌ 不支持的文件格式: {input_path.suffix}\")\n",
    "            print(f\"支持的格式: {', '.join(supported_formats)}\")\n",
    "            return None\n",
    "    \n",
    "    else:\n",
    "        print(f\"❌ 路径不存在: {input_path}\")\n",
    "        return None\n",
    "\n",
    "# 示例输入文件\n",
    "input_file = \"path/to/your/genome.gbk\"  # 替换为您的文件路径\n",
    "# input_file = \"path/to/your/sequence.fna\"  # FASTA格式也可以\n",
    "\n",
    "prepared_file = prepare_input_files(input_file)"
   ]
