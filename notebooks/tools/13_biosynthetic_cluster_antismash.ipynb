",
    "                                'start': int(feature.location.start),\n",
",
    "                                'end': int(feature.location.end),\n",
",
    "                                'type': feature.qualifiers.get('product', ['unknown'])[0],\n",
",
    "                                'note': feature.qualifiers.get('note', [''])[0]\n",
",
    "                            }\n",
",
    "                            results['cluster_details'].append(cluster_info)\n",
",
    "            except Exception as e:\n",
    "                print(f\"⚠️ 解析文件失败 {gbk_file}: {e}\")\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"❌ 结果解析错误: {e}\")\n",
    "    \n",
    "    return results\n",
    "\n",
    "# 解析结果\n",
    "if output_dir:\n",
    "    antismash_results = parse_antismash_results(output_dir)\n",
    "else:\n",
    "    antismash_results = None\n",
    "    print(\"⚠️ 没有结果可供解析\")"
