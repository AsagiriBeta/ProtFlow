   "source": [
    "# 抗生素合成基因簇分析工作流 (antiSMASH)\n",
    "\n",
    "**主要功能：**\n",
    "- 使用 antiSMASH 分析生物合成基因簇 (BGC)\n",
    "- 识别抗生素、天然产物等次级代谢产物合成基因\n",
    "- 生成详细的BGC注释报告\n",
    "- 支持细菌和真菌基因组分析\n",
    "\n",
    "**输入：**\n",
    "- GenBank文件 (.gbk, .gbff)\n",
    "- 核酸序列文件 (.fna, .fa, .fasta)\n",
    "\n",
    "**输出：**\n",
    "- BGC注释结果 (HTML报告, GenBank文件)\n",
    "- 基因簇分类和统计\n",
    "- 潜在产物预测\n",
    "\n",
    "**系统要求：**\n",
    "- antiSMASH 及其依赖\n",
    "- 约 10-20 GB 磁盘空间\n",
    "- 运行时间取决于基因组大小"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 环境设置与依赖安装"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "from pathlib import Path\n",
    "import subprocess\n",
    "import shutil\n",
    "\n",
    "# 项目根目录\n",
    "PROJECT_ROOT = Path(os.environ.get('PROTFLOW_ROOT', Path.cwd())).resolve()\n",
    "WORK_DIR = PROJECT_ROOT / 'antismash_runs'\n",
    "WORK_DIR.mkdir(exist_ok=True, parents=True)\n",
    "\n",
    "print(f\"工作目录: {WORK_DIR}\")\n",
    "print(f\"项目根目录: {PROJECT_ROOT}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def check_antismash_installation():\n",
    "    \"\"\"检查antiSMASH安装状态\"\"\"\n",
    "    \n",
    "    # 检查antiSMASH命令\n",
    "    antismash_available = shutil.which('antismash') is not None\n",
    "    \n",
    "    # 检查Python包\n",
    "    required_packages = ['biopython', 'pandas', 'numpy', 'matplotlib', 'seaborn']\n",
    "    missing_packages = []\n",
    "    \n",
    "    for package in required_packages:\n",
    "        try:\n",
    "            __import__(package)\n",
    "        except ImportError:\n",
    "            missing_packages.append(package)\n",
    "    \n",
    "    print(\"=== antiSMASH环境检查 ===\")\n",
    "    print(f\"antiSMASH命令: {'✓ 可用' if antismash_available else '❌ 未找到'}\")\n",
    "    \n",
    "    if missing_packages:\n",
    "        print(f\"❌ 缺少Python包: {', '.join(missing_packages)}\")\n",
    "    else:\n",
    "        print(\"✓ 所有Python包已安装\")\n",
    "    \n",
    "    return antismash_available, missing_packages\n",
    "\n",
    "antismash_ok, missing_pkgs = check_antismash_installation()\n",
    "\n",
    "# 安装缺少的Python包\n",
    "if missing_pkgs:\n",
    "    print(f\"正在安装: {', '.join(missing_pkgs)}\")\n",
    "    for pkg in missing_pkgs:\n",
    "        subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", pkg])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 安装antiSMASH"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def install_antismash():\n",
    "    \"\"\"安装antiSMASH及其依赖\"\"\"\n",
    "    \n",
    "    print(\"正在安装 antiSMASH...\")\n",
    "    \n",
    "    try:\n",
    "        # 方法1: 使用conda/mamba安装 (推荐)\n",
    "        print(\"尝试使用conda安装...\")\n",
    "        result = subprocess.run([\n",
    "            'conda', 'install', '-y', '-c', 'bioconda', '-c', 'conda-forge',\n",
    "            'antismash', 'hmmer', 'diamond', 'fasttree', 'prodigal', 'meme',\n",
    "            'glimmerhmm', 'bwa', 'blast', 'muscle', 'clustalw'\n",
    "        ], capture_output=True, text=True)\n",
    "        \n",
    "        if result.returncode == 0:\n",
    "            print(\"✓ antiSMASH 安装成功 (conda)\")\n",
    "            return True\n",
    "        else:\n",
    "            print(f\"conda安装失败: {result.stderr[:200]}...\")\n",
    "    \n",
    "    except FileNotFoundError:\n",
    "        print(\"conda未找到，尝试其他方法...\")\n",
    "    \n",
    "    try:\n",
    "        # 方法2: 使用pip安装antiSMASH\n",
    "        print(\"尝试使用pip安装...\")\n",
    "        subprocess.check_call([\n",
    "            sys.executable, \"-m\", \"pip\", \"install\", \"antismash\"\n",
    "        ])\n",
    "        print(\"✓ antiSMASH Python包安装成功\")\n",
    "        \n",
    "        # 下载并安装依赖工具\n",
    "        print(\"需要手动安装依赖工具:\")\n",
    "        print(\"- HMMER (hmmer.org)\")\n",
    "        print(\"- DIAMOND (github.com/bbuchfink/diamond)\")\n",
    "        print(\"- FastTree (github.com/kimoyori/FastTreeMP)\")\n",
    "        print(\"- 其他工具请参考antiSMASH文档\")\n",
    "        \n",
    "        return True\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"pip安装失败: {e}\")\n",
    "    \n",
    "    # 方法3: 下载预编译版本\n",
    "    print(\"尝试下载预编译版本...\")\n",
    "    import urllib.request\n",
    "    import platform\n",
    "    \n",
    "    system = platform.system().lower()\n",
    "    if system == 'linux':\n",
    "        # 这里应该根据实际版本调整URL\n",
    "        antismash_url = \"https://github.com/antismash/antismash/releases/download/antismash-7.1.0/antismash-7.1.0-linux-x86_64.tar.gz\"\n",
    "        tar_file = WORK_DIR / 'antismash.tar.gz'\n",
    "    else:\n",
    "        print(f\"❌ 不支持的操作系统: {system}\")\n",
    "        return False\n",
    "    \n",
    "    try:\n",
    "        print(f\"正在下载 antiSMASH...\")\n",
    "        urllib.request.urlretrieve(antismash_url, tar_file)\n",
    "        \n",
    "        # 解压\n",
    "        import tarfile\n",
    "        with tarfile.open(tar_file, 'r:gz') as tar:\n",
    "            tar.extractall(WORK_DIR)\n",
    "        \n",
    "        # 添加到PATH\n",
    "        antismash_bin = WORK_DIR / 'antismash' / 'bin'\n",
    "        if antismash_bin.exists():\n",
    "            os.environ['PATH'] = str(antismash_bin) + ':' + os.environ.get('PATH', '')\n",
    "            print(\"✓ antiSMASH 安装完成\")\n",
    "            return True\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ 下载安装失败: {e}\")\n",
    "        return False\n",
    "    \n",
    "    finally:\n",
    "        # 清理下载文件\n",
    "        if tar_file.exists():\n",
    "            tar_file.unlink()\n",
    "    \n",
    "    return False\n",
    "\n",
    "# 如果需要，安装antiSMASH\n",
    "if not antismash_ok:\n",
    "    print(\"尝试安装antiSMASH...\")\n",
    "    install_antismash()\n",
    "    # 重新检查\n",
    "    antismash_ok, _ = check_antismash_installation()\n",
    "    if not antismash_ok:\n",
    "        print(\"⚠️ 请手动安装antiSMASH\")\n",
    "        print(\"文档: https://docs.antismash.secondarymetabolites.org/install/\")"
   ]
  },
