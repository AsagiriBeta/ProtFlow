    "def analyze_antismash_results(results):\n",
    "    \"\"\"分析antiSMASH结果\"\"\"\n",
    "    \n",
    "    if not results:\n",
    "        print(\"没有结果可供分析\")\n",
    "        return\n",
    "    \n",
    "    print(\"=== antiSMASH分析结果汇总 ===\")\n",
    "    print(f\"总基因簇数: {results['num_clusters']}\")\n",
    "    \n",
    "    if results['cluster_types']:\n",
    "        print(f\"\\n基因簇类型分布:\")\n",
    "        for cluster_type, count in sorted(results['cluster_types'].items(), key=lambda x: x[1], reverse=True):\n",
    "            print(f\"  {cluster_type}: {count}\")\n",
    "    \n",
    "    if results['cluster_details']:\n",
    "        print(f\"\\n详细基因簇信息:\")\n",
    "        for i, cluster in enumerate(results['cluster_details'][:5], 1):\n",
    "            size = cluster['end'] - cluster['start']\n",
    "            print(f\"  {i}. {cluster['type']} (位置: {cluster['contig']}:{cluster['start']}-{cluster['end']}, 大小: {size} bp)\")\n",
    "            if cluster['note']:\n",
    "                print(f\"     注释: {cluster['note'][:100]}...\")\n",
    "        \n",
    "        if len(results['cluster_details']) > 5:\n",
    "            print(f\"  ... 还有 {len(results['cluster_details']) - 5} 个基因簇\")\n",
    "    \n",
    "    # 创建汇总表\n",
    "    if results['cluster_details']:\n",
    "        import pandas as pd\n",
    "        df = pd.DataFrame(results['cluster_details'])\n",
    "        df['size'] = df['end'] - df['start']\n",
    "        \n",
    "        print(f\"\\n基因簇统计:\")\n",
    "        print(f\"  平均大小: {df['size'].mean():.0f} bp\")\n",
    "        print(f\"  大小范围: {df['size'].min()}-{df['size'].max()} bp\")\n",
    "        \n",
    "        # 按类型统计\n",
    "        type_stats = df.groupby('type').agg({\n",
    "            'size': ['count', 'mean', 'min', 'max']\n",
    "        }).round(0)\n",
    "        \n",
    "        print(f\"\\n按类型统计:\")\n",
    "        print(type_stats)\n",
    "        \n",
    "        # 保存结果\n",
    "        summary_file = Path(results['output_dir']) / 'cluster_summary.csv'\n",
    "        df.to_csv(summary_file, index=False)\n",
    "        print(f\"\\n✓ 详细结果保存: {summary_file}\")\n",
    "\n",
    "# 分析结果\n",
    "analyze_antismash_results(antismash_results)"
   ]
