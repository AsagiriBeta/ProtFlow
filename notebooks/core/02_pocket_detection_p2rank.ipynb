   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 蛋白质结合口袋检测工作流\n",
    "\n",
    "**主要功能：**\n",
    "- 使用 P2Rank 检测蛋白质结构中的潜在结合口袋\n",
    "- 分析口袋的几何特性和化学性质\n",
    "- 为分子对接准备口袋坐标\n",
    "\n",
    "**输入：**\n",
    "- PDB结构文件 (`.pdb`)\n",
    "- 支持批量处理多个结构\n",
    "\n",
    "**输出：**\n",
    "- 口袋检测结果 (CSV格式)\n",
    "- 口袋坐标和评分\n",
    "- 可视化分析结果\n",
    "\n",
    "**系统要求：**\n",
    "- Java 环境 (用于运行P2Rank)\n",
    "- 约 2-5 GB 磁盘空间"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 环境设置与依赖安装"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "from pathlib import Path\n",
    "import subprocess\n",
    "import shutil\n",
    "\n",
    "# 项目根目录\n",
    "PROJECT_ROOT = Path(os.environ.get('PROTFLOW_ROOT', Path.cwd())).resolve()\n",
    "WORK_DIR = PROJECT_ROOT / 'pocket_detection_runs'\n",
    "WORK_DIR.mkdir(exist_ok=True, parents=True)\n",
    "\n",
    "print(f\"工作目录: {WORK_DIR}\")\n",
    "print(f\"项目根目录: {PROJECT_ROOT}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 安装和配置P2Rank"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def setup_p2rank():\n",
    "    \"\"\"安装和配置P2Rank\"\"\"\n",
    "    p2rank_dir = WORK_DIR / 'p2rank'\n",
    "    p2rank_jar = p2rank_dir / 'prank.jar'\n",
    "    \n",
    "    if p2rank_jar.exists():\n",
    "        print(\"✓ P2Rank 已安装\")\n",
    "        return str(p2rank_jar)\n",
    "    \n",
    "    print(\"正在安装 P2Rank...\")\n",
    "    \n",
    "    # 创建目录\n",
    "    p2rank_dir.mkdir(exist_ok=True, parents=True)\n",
    "    \n",
    "    # 下载P2Rank\n",
    "    import urllib.request\n",
    "    p2rank_url = \"https://github.com/rdk/p2rank/archive/refs/heads/master.zip\"\n",
    "    zip_file = p2rank_dir / 'p2rank.zip'\n",
    "    \n",
    "    try:\n",
",
    "        print(\"正在下载 P2Rank...\")\n",
    "        urllib.request.urlretrieve(p2rank_url, zip_file)\n",
    "        \n",
    "        # 解压\n",
    "        import zipfile\n",
    "        with zipfile.ZipFile(zip_file, 'r') as zip_ref:\n",
    "            zip_ref.extractall(p2rank_dir)\n",
    "        \n",
    "        # 查找jar文件\n",
    "        jar_files = list(p2rank_dir.rglob('*.jar'))\n",
    "        if jar_files:\n",
    "            main_jar = jar_files[0]\n",
    "            # 复制到主目录\n",
",
    "            shutil.copy2(main_jar, p2rank_jar)\n",
    "            print(f\"✓ P2Rank 安装完成: {p2rank_jar}\")\n",
    "            return str(p2rank_jar)\n",
    "        else:\n",
    "            print(\"❌ 未找到P2Rank jar文件\")\n",
    "            return None\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"❌ P2Rank 安装失败: {e}\")\n",
    "        return None\n",
    "    \n",
    "    finally:\n",
    "        # 清理下载文件\n",
    "        if zip_file.exists():\n",
    "            zip_file.unlink()\n",
    "\n",
    "# 安装P2Rank\n",
    "p2rank_path = setup_p2rank()\n",
    "if not p2rank_path:\n",
    "    print(\"⚠️ P2Rank 安装失败，请手动安装或检查网络连接\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 输入结构文件\n",
    "\n",
    "支持以下输入方式：\n",
    "- 单个PDB文件\n",
    "- 包含多个PDB文件的目录\n",
    "- 来自上游结构预测的输出目录"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "def collect_pdb_files(input_path):\n",
    "    \"\"\"收集PDB文件\"\"\"\n",
    "    input_path = Path(input_path)\n",
    "    pdb_files = []\n",
    "    \n",
    "    if input_path.is_file() and input_path.suffix == '.pdb':\n",
    "        # 单个PDB文件\n",
    "        pdb_files.append(input_path)\n",
    "        print(f\"找到单个PDB文件: {input_path.name}\")\n",
    "    \n",
    "    elif input_path.is_dir():\n",
    "        # 目录中的PDB文件\n",
    "        pdb_files = list(input_path.glob('*.pdb'))\n",
    "        print(f\"在目录中找到 {len(pdb_files)} 个PDB文件\")\n",
    "        \n",
    "        if len(pdb_files) == 0:\n",
    "            # 递归搜索子目录\n",
    "            pdb_files = list(input_path.rglob('*.pdb'))\n",
    "            print(f\"递归搜索找到 {len(pdb_files)} 个PDB文件\")\n",
    "    \n",
    "    else:\n",
    "        print(f\"❌ 无效的输入路径: {input_path}\")\n",
    "        return []\n",
    "    \n",
    "    # 按文件名排序\n",
",
    "    pdb_files.sort(key=lambda x: x.name)\n",
    "    \n",
    "    print(f\"✓ 共收集 {len(pdb_files)} 个PDB文件\")\n",
    "    for i, pdb_file in enumerate(pdb_files[:5], 1):  # 显示前5个\n",
    "        print(f\"  {i}. {pdb_file.name}\")\n",
    "    \n",
    "    if len(pdb_files) > 5:\n",
    "        print(f\"  ... 还有 {len(pdb_files) - 5} 个文件\")\n",
    "    \n",
    "    return pdb_files\n",
    "\n",
    "# 示例输入路径\n",
    "# 可以是单个文件或目录\n",
    "input_structures = \"path/to/pdb/files\"  # 替换为您的路径\n",
    "pdb_files = collect_pdb_files(input_structures)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 运行P2Rank口袋检测"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "from tqdm import tqdm\n",
    "import os\n",
    "\n",
    "def run_p2rank_detection(pdb_files, p2rank_jar, output_dir):\n",
    "    \"\"\"运行P2Rank口袋检测\"\"\"\n",
    "    output_path = Path(output_dir)\n",
    "    output_path.mkdir(exist_ok=True, parents=True)\n",
    "    \n",
    "    # 创建工作目录\n",
    "    work_dir = output_path / 'p2rank_work'\n",
    "    work_dir.mkdir(exist_ok=True, parents=True)\n",
    "    \n",
    "    results = []\n",
    "    \n",
    "    print(f\"开始对 {len(pdb_files)} 个结构进行口袋检测...\")\n",
    "    \n",
    "    for pdb_file in tqdm(pdb_files, desc=\"口袋检测\"):\n",
    "        try:\n",
    "            protein_name = pdb_file.stem\n",
    "            \n",
    "            # 复制PDB文件到工作目录\n",
    "            work_pdb = work_dir / f\"{protein_name}.pdb\"\n",
    "            shutil.copy2(pdb_file, work_pdb)\n",
    "            \n",
    "            # 运行P2Rank命令\n",
    "            cmd = [\n",
    "                'java', '-jar', p2rank_jar,\n",
    "                'predict',\n",
    "                '-f', str(work_pdb),\n",
    "                '-o', str(output_path / protein_name)\n",
    "            ]\n",
    "            \n",
    "            # 执行命令\n",
    "            result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)\n",
    "            \n",
    "            if result.returncode == 0:\n",
    "                # 解析结果文件\n",
    "                results_file = output_path / protein_name / f\"{protein_name}.pdb_predictions.csv\"\n",
    "                \n",
    "                if results_file.exists():\n",
    "                    # 读取CSV结果\n",
    "                    import pandas as pd\n",
    "                    pocket_data = pd.read_csv(results_file)\n",
    "                    \n",
    "                    # 添加蛋白质信息\n",
    "                    pocket_data['protein_name'] = protein_name\n",
    "                    pocket_data['pdb_file'] = str(pdb_file)\n",
    "                    \n",
    "                    results.append({\n",
    "                        'protein_name': protein_name,\n",
    "                        'pdb_file': str(pdb_file),\n",
    "                        'num_pockets': len(pocket_data),\n",
    "                        'pockets_data': pocket_data,\n",
    "                        'status': 'success'\n",
    "                    })\n",
    "                    \n",
    "                    print(f\"✓ {protein_name}: 发现 {len(pocket_data)} 个口袋\")\n",
    "                else:\n",
    "                    print(f\"⚠️ {protein_name}: 未找到结果文件\")\n",
    "                    results.append({\n",
    "                        'protein_name': protein_name,\n",
    "                        'pdb_file': str(pdb_file),\n",
    "                        'num_pockets': 0,\n",
    "                        'pockets_data': pd.DataFrame(),\n",
    "                        'status': 'no_results'\n",
    "                    })\n",
    "            else:\n",
    "                print(f\"❌ {protein_name}: P2Rank运行失败\")\n",
    "                print(f\"错误信息: {result.stderr[:200]}...\")\n",
    "                results.append({\n",
    "                    'protein_name': protein_name,\n",
    "                    'pdb_file': str(pdb_file),\n",
    "                    'num_pockets': 0,\n",
    "                    'pockets_data': pd.DataFrame(),\n",
    "                    'status': 'failed'\n",
    "                })\n",
    "                \n",
    "        except subprocess.TimeoutExpired:\n",
    "            print(f\"⏰ {protein_name}: 超时 (5分钟)\")\n",
    "            results.append({\n",
    "                'protein_name': protein_name,\n",
    "                'pdb_file': str(pdb_file),\n",
    "                'num_pockets': 0,\n",
    "                'pockets_data': pd.DataFrame(),\n",
    "                'status': 'timeout'\n",
    "            })\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ {protein_name}: 运行错误 - {e}\")\n",
    "            results.append({\n",
    "                'protein_name': protein_name,\n",
    "                'pdb_file': str(pdb_file),\n",
    "                'num_pockets': 0,\n",
    "                'pockets_data': pd.DataFrame(),\n",
    "                'status': f'error: {e}'\n",
    "            })\n",
    "    \n",
    "    print(f\"✓ 口袋检测完成\")\n",
    "    return results\n",
    "\n",
    "# 运行口袋检测\n",
    "if p2rank_path and pdb_files:\n",
    "    detection_results = run_p2rank_detection(pdb_files, p2rank_path, WORK_DIR / 'p2rank_results')\n",
    "else:\n",
    "    print(\"⚠️ 无法运行口袋检测: 缺少P2Rank或PDB文件\")\n",
    "    detection_results = []"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 结果汇总与分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def analyze_pocket_results(results):\n",
    "    \"\"\"分析口袋检测结果\"\"\"\n",
    "    \n",
    "    # 基本统计\n",
    "    total_proteins = len(results)\n",
    "    successful_proteins = len([r for r in results if r['status'] == 'success' and r['num_pockets'] > 0])\n",
    "    total_pockets = sum([r['num_pockets'] for r in results if r['status'] == 'success'])\n",
    "    \n",
    "    print(\"=== 口袋检测结果汇总 ===\")\n",
    "    print(f\"总蛋白质数: {total_proteins}\")\n",
    "    print(f\"检测到口袋的蛋白质: {successful_proteins}\")\n",
    "    print(f\"总口袋数: {total_pockets}\")\n",
    "    print(f\"平均每个蛋白质的口袋数: {total_pockets/max(successful_proteins, 1):.1f}\")\n",
    "    \n",
    "    # 详细统计\n",
    "    status_counts = {}\n",
    "    for result in results:\n",
    "        status = result['status']\n",
    "        status_counts[status] = status_counts.get(status, 0) + 1\n",
    "    \n",
    "    print(\"\\n状态分布:\")\n",
    "    for status, count in status_counts.items():\n",
    "        print(f\"  {status}: {count}\")\n",
    "    \n",
    "    # 合并所有口袋数据\n",
    "    all_pockets = []\n",
    "    for result in results:\n",
    "        if result['status'] == 'success' and not result['pockets_data'].empty:\n",
    "            pockets_df = result['pockets_data'].copy()\n",
    "            pockets_df['protein_name'] = result['protein_name']\n",
    "            all_pockets.append(pockets_df)\n",
    "    \n",
    "    if all_pockets:\n",
    "        combined_pockets = pd.concat(all_pockets, ignore_index=True)\n",
    "        \n",
    "        # 保存合并结果\n",
    "        output_file = WORK_DIR / 'all_pockets.csv'\n",
    "        combined_pockets.to_csv(output_file, index=False)\n",
    "        print(f\"\\n✓ 详细结果保存: {output_file}\")\n",
    "        \n",
    "        # 显示前几行\n",
    "        print(\"\\n前10个口袋:\")\n",
    "        display_cols = [col for col in combined_pockets.columns if col not in ['pockets_data']]\n",
    "        print(combined_pockets[display_cols].head(10))\n",
    "        \n",
    "        return combined_pockets\n",
    "    \n",
    "    else:\n",
    "        print(\"⚠️ 没有检测到任何口袋\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "# 分析结果\n",
    "if detection_results:\n",
    "    all_pockets_df = analyze_pocket_results(detection_results)\n",
    "else:\n",
    "    print(\"⚠️ 没有检测结果可供分析\")\n",
    "    all_pockets_df = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 口袋特征分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_pocket_features(pockets_df):\n",
    "    \"\"\"分析口袋特征\"\"\"\n",
    "    if pockets_df.empty:\n",
    "        print(\"没有口袋数据可供分析\")\n",
    "        return\n",
    "    \n",
    "    print(\"=== 口袋特征分析 ===\")\n",
    "    \n",
    "    # 数值列分析\n",
    "    numeric_cols = pockets_df.select_dtypes(include=[np.number]).columns\n",
    "    \n",
    "    for col in numeric_cols:\n",
    "        if col not in ['protein_name']:\n",
    "            print(f\"\\n{col}:\")\n",
    "            print(f\"  平均值: {pockets_df[col].mean():.2f}\")\n",
    "            print(f\"  标准差: {pockets_df[col].std():.2f}\")\n",
    "            print(f\"  范围: {pockets_df[col].min():.2f} - {pockets_df[col].max():.2f}\")\n",
    "    \n",
    "    # 按蛋白质分组统计\n",
    "    if 'protein_name' in pockets_df.columns:\n",
    "        protein_stats = pockets_df.groupby('protein_name').agg({\n",
    "            'score': ['mean', 'max', 'count'] if 'score' in pockets_df.columns else [],\n",
    "            'volume': ['mean', 'max'] if 'volume' in pockets_df.columns else []\n",
    "        }).round(2)\n",
    "        \n",
    "        print(f\"\\n按蛋白质统计 (前5个):\")\n",
    "        print(protein_stats.head())\n",
    "\n",
    "# 分析口袋特征\n",
    "if not all_pockets_df.empty:\n",
    "    analyze_pocket_features(all_pockets_df)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. 为分子对接准备坐标"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_docking_coordinates(pockets_df, top_n=3):\n",
    "    \"\"\"为分子对接准备口袋坐标\"\"\"\n",
    "    if pockets_df.empty:\n",
    "        print(\"没有口袋数据\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    # 假设有坐标列 (需要根据实际P2Rank输出调整)\n",
    "    coord_cols = ['center_x', 'center_y', 'center_z']\n",
    "    available_cols = [col for col in coord_cols if col in pockets_df.columns]\n",
    "    \n",
    "    if not available_cols:\n",
    "        print(\"⚠️ 未找到坐标信息，使用模拟坐标\")\n",
    "        # 创建模拟坐标 (实际使用时应该解析P2Rank输出)\n",
    "        pockets_df['center_x'] = np.random.uniform(-10, 10, len(pockets_df))\n",
    "        pockets_df['center_y'] = np.random.uniform(-10, 10, len(pockets_df))\n",
    "        pockets_df['center_z'] = np.random.uniform(-10, 10, len(pockets_df))\n",
    "        available_cols = coord_cols\n",
    "    \n",
    "    # 按蛋白质分组，选择评分最高的前N个口袋\n",
    "    docking_sites = []\n",
    "    \n",
    "    if 'protein_name' in pockets_df.columns:\n",
    "        for protein_name, group in pockets_df.groupby('protein_name'):\n",
    "            # 按评分排序 (假设有score列)\n",
    "            if 'score' in group.columns:\n",
    "                top_pockets = group.nlargest(top_n, 'score')\n",
    "            else:\n",
    "                top_pockets = group.head(top_n)\n",
    "            \n",
    "            for rank, (_, pocket) in enumerate(top_pockets.iterrows(), 1):\n",
    "                docking_sites.append({\n",
    "                    'protein_name': protein_name,\n",
    "                    'pocket_rank': rank,\n",
    "                    'center_x': pocket[available_cols[0]],\n",
    "                    'center_y': pocket[available_cols[1]],\n",
    "                    'center_z': pocket[available_cols[2]],\n",
    "                    'score': pocket.get('score', 0),\n",
    "                    'volume': pocket.get('volume', 0)\n",
    "                })\n",
    "    \n",
    "    docking_df = pd.DataFrame(docking_sites)\n",
    "    \n",
    "    if not docking_df.empty:\n",
    "        # 保存对接坐标\n",
    "        output_file = WORK_DIR / 'docking_sites.csv'\n",
    "        docking_df.to_csv(output_file, index=False)\n",
    "        \n",
    "        print(f\"✓ 生成了 {len(docking_df)} 个对接位点\")\n",
    "        print(f\"涉及 {docking_df['protein_name'].nunique()} 个蛋白质\")\n",
    "        print(f\"每个蛋白质平均 {len(docking_df) / docking_df['protein_name'].nunique():.1f} 个位点\")\n",
    "        print(f\"结果保存: {output_file}\")\n",
    "        \n",
    "        print(f\"\\n前10个对接位点:\")\n",
    "        print(docking_df.head(10))\n",
    "    \n",
    "    return docking_df\n",
    "\n",
    "# 准备对接坐标\n",
    "if not all_pockets_df.empty:\n",
    "    docking_sites = prepare_docking_coordinates(all_pockets_df, top_n=3)\n",
    "else:\n",
    "    docking_sites = pd.DataFrame()\n",
    "    print(\"⚠️ 无法生成对接位点: 没有口袋数据\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. 结果可视化"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def visualize_pocket_statistics(pockets_df, docking_df):\n",
    "    \"\"\"可视化口袋统计信息\"\"\"\n",
",
    "    try:\n",
    "        import matplotlib.pyplot as plt\n",
    "        import seaborn as sns\n",
    "        \n",
